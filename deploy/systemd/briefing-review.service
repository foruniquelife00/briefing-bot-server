[Unit]
Description=Briefing Bot - Evening review (17:50 KST, oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/briefing-bot-server
ExecStart=/usr/bin/python3 /root/briefing-bot-server/bot.py review
TimeoutStartSec=600
StandardOutput=append:/root/briefing-bot-server/timer.log
StandardError=append:/root/briefing-bot-server/timer.log
